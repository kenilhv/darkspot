{
  "name": "@darkspot/ui",
  "version": "0.1.0",
  "description": "DarkSpot shared design system \u2014 tokens + React components for the coordinator dashboard, swarm visualization frame, and LibreChat theme",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./src/tokens.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist",
    "src",
    "tokens.json"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-css.mjs && node scripts/export-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "verify": "npm run typecheck && npm run check:contrast && npm run build && npm run assert",
    "dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "export:tokens": "node scripts/export-tokens.mjs",
    "assert": "node scripts/assert-evidence.mjs && node scripts/assert-sim.mjs && node scripts/assert-coordinator.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
