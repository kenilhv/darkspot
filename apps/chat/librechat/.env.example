# Copy to .env (gitignored). Generate secrets: openssl rand -hex 32 (keys), openssl rand -hex 16 (CREDS_IV)
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=

# Model shown in LibreChat; must be a model id the upstream accepts. No default is guessed.
DARKSPOT_MODEL=

# Guard proxy upstream (OpenAI-compatible). inference.net per §2; Anthropic's OpenAI-compat layer also works.
# Unset → chat returns 503 (an honest "no upstream"), never a canned answer.
UPSTREAM_BASE_URL=https://api.inference.net/v1
UPSTREAM_API_KEY=

# Field-report extraction (inference.net). Unset → reports stored as extracted_status='unextracted', marked unverified.
INFERENCE_BASE_URL=https://api.inference.net/v1
INFERENCE_API_KEY=
INFERENCE_MODEL=

# CORE's databases. Defaults below are CORE's local docker-compose (../darkspot-core: ClickHouse :8124, Postgres :5433),
# reached from inside the compose network via host.docker.internal. For the shared cloud instance use the values
# from the gitignored repo-root .env (D-9) — never commit them.
CLICKHOUSE_URL=http://host.docker.internal:8124
CLICKHOUSE_USER=darkspot
CLICKHOUSE_PASSWORD=darkspot
CLICKHOUSE_DB=darkspot
DATABASE_URL=postgres://darkspot:darkspot@host.docker.internal:5433/darkspot

# This bridge node's 32-byte identity (64 hex chars) — mesh_events.bridge_pubkey is FixedString(32) NOT NULL in CORE's
# schema. Unset → reports stay in the local outbox only. Generate: openssl rand -hex 32
BRIDGE_PUBKEY_HEX=

# HoneyHive tracing (extraction -> ranking -> route -> chat turn). Unset -> spans recorded to data/trace.jsonl only, marked NOT sent, tracing unverified.
HH_API_KEY=
HH_PROJECT=darkspot
